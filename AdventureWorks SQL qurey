-- CTE selecting relevent ungrouped data to be grouped by store
WITH StoreSales AS
	(
		SELECT
			c.StoreID AS StoreBusinessEntityID,  -- Store ID from the Customer table
			COUNT(*) AS TotalOrders,             -- Count of total sales orders for the store
			SUM(soh.TotalDue) AS TotalRevenue,    -- Total revenue generated by the store
			MIN(soh.OrderDate) AS FirstTradingDate,	-- Latest trading date
			MAX(soh.OrderDate) AS LastTradingDate	-- Earliest trading date
		FROM [AdventureWorks2019].[Sales].[SalesOrderHeader] AS soh
		INNER JOIN [AdventureWorks2019].[Sales].[Customer] AS c 
			ON soh.CustomerID = c.CustomerID -- Join to get StoreID
		WHERE c.StoreID IS NOT NULL  -- Ensure only store-based customers are included
		GROUP BY c.StoreID           -- Group by StoreID to aggregate sales data
	)
-- Main query using data grouped by store
SELECT
	S.Name AS StoreName,
	SS.FirstTradingDate,
    SS.LastTradingDate,
	DATEDIFF(YEAR, SS.FirstTradingDate, SS.LastTradingDate) AS TradingDurationYears,	-- Calculate the trading duration
	SV.AnnualRevenue,
	COALESCE(SS.TotalRevenue, 0) AS TotalRevenue,
	COALESCE(SS.TotalOrders, 0) AS TotalOrders 
FROM [AdventureWorks2019].[Sales].[Store] AS S
LEFT JOIN StoreSales AS SS
	ON S.BusinessEntityID = SS.StoreBusinessEntityID
LEFT JOIN	[AdventureWorks2019].[Sales].[vStoreWithDemographics] AS SV	-- Join to get the annual revenue
	ON SV.BusinessEntityID = S.BusinessEntityID
ORDER BY TradingDurationYears DESC;
